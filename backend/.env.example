PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=<long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=1h
# Comma-separated list allowed, e.g. http://localhost:5173,https://campuseats.vercel.app
CLIENT_URL=http://localhost:5173

# Used once by `npm run seed:admin` to create the admin account
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@campuseats.com
ADMIN_PASSWORD=<choose a strong password>
